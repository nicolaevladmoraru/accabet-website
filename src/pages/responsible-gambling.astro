---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Responsible Gambling | AccaBet">
  <main class="page-shell">
    <div class="eyebrow">18+ ONLY</div>
    <h1>Responsible Gambling</h1>
    <p>AccaBet is an accumulator ticket generator, not a bookmaker.
      It does not accept bets or guarantee outcomes.</p>
    <p>Only gamble with money you can afford to lose. If gambling is
      affecting you or someone close to you, visit
      <a href="https://www.gamcare.org.uk/" target="_blank"
         rel="noopener noreferrer">GamCare</a> for support.</p>
  </main>
</BaseLayout>